# Backend Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:8090

# Default Operating Mode: 'demo' or 'live'
# Users/Admins can also switch modes dynamically from the dashboard UI
# Demo sandbox (in-memory sample data). Keep false in production — ITSM Center uses the live Znuny CMDB.
ENABLE_DEMO_MODE=false

# Safety Gate: Keep false until Znuny API operations & CI schemas are verified
ALLOW_LIVE_WRITES=false

# Znuny GenericInterface Connection
ZNUNY_BASE_URL=https://mysupportstaging.atlancis.com/otrs/nph-genericinterface.pl
ZNUNY_HOST_HEADER=mysupportstaging.atlancis.com
ZNUNY_REJECT_UNAUTHORIZED=false
ZNUNY_TIMEOUT_MS=25000

# Configured Znuny GenericInterface Webservice Names
ZNUNY_WS_TICKET=portal_with_catalogue
ZNUNY_WS_CMDB=PDU_CircuitsOutlets_API
ZNUNY_WS_SLA=SLA Api

# Optional Service Account (used only on backend if background/service queries need auth)
ZNUNY_SERVICE_USER=
ZNUNY_SERVICE_PASSWORD=

# Role-Based Access Control (comma-separated Znuny UserLogins)
ADMIN_USERS=root@localhost,David,Njuguna,Julius.Mutai
VIEWER_USERS=

# Cache TTL in seconds for expensive CMDB/Ticket list aggregations
CACHE_TTL_SECONDS=60
